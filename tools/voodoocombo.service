[Unit]
Description=VoodooCombo dedicated server
After=network-online.target
Wants=network-online.target

[Service]
User=godotserver
WorkingDirectory=/opt/voodoocombo
ExecStart=/opt/voodoocombo/VoodooCombo-server.arm64 --headless -- --server --port 7777
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=voodoocombo
Environment=XDG_DATA_HOME=/var/lib/voodoocombo

[Install]
WantedBy=multi-user.target
